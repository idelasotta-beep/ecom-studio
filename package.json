{
  "name": "mi-dropi",
  "version": "1.0.0",
  "description": "Mi Dropi - Backend + Frontend",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "electron": "node scripts/run-electron.js",
    "electron:build": "electron-builder"
  },
  "build": {
    "appId": "com.idelasotta.ecomstudio",
    "productName": "Ecom Studio IA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "scripts/run-electron.js",
      "*.html",
      "og-image.png",
      "!server/ecommagic.json*",
      "!server/ads/**",
      "!server/ad-templates/**",
      "!server/meta-ads/**",
      "!server/landings/**",
      "!server/mockups/**",
      "!server/logos/**",
      "!server/text-to-image/**",
      "!server/ebooks/**",
      "!server/ebook-images/**",
      "!server/voiceovers/**",
      "!server/tmp-uploads/**"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "puppeteer": "^23.0.0",
    "sharp": "^0.34.5",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "docx": "^9.7.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
