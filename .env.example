# ─────────────────────────────────────────────────────────────────
# Variables de entorno requeridas
# Copia este archivo a `.env` y completa los valores antes de arrancar
# ─────────────────────────────────────────────────────────────────

# OBLIGATORIO en producción. En dev, si no se define, se genera uno
# aleatorio por sesión (los tokens no sobreviven a un restart).
# Usa al menos 64 caracteres aleatorios. Genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OBLIGATORIO en producción. En dev, si no se define, se genera uno
# aleatorio y se imprime UNA SOLA VEZ en consola al primer arranque.
ADMIN_EMAIL=admin@miempresa.com
ADMIN_PASSWORD=

# Modo de ejecución. Usa "production" en Railway/Render/etc.
NODE_ENV=development

# Puerto del servidor. Railway/Heroku setean esto automáticamente.
PORT=3000

# Lista de orígenes permitidos para CORS, separados por coma.
# Ejemplos:
#   *                                         (cualquier origen — solo dev)
#   https://miapp.com,https://www.miapp.com   (producción)
ALLOWED_ORIGINS=*

# OPCIONAL — sólo si vas a usar el módulo Meta Ads Spy.
# El usuario configura su propia key vía Ajustes → APIs, así que
# normalmente no necesitas estas variables. Sirven sólo si quieres
# overrides globales.
APIFY_ACTOR_ID=curious_coder~facebook-ads-library-scraper
APIFY_TIMEOUT_MS=90000
APIFY_MEMORY_MB=512
META_SPY_RATE_LIMIT=10
