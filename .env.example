# ─────────────────────────────────────────────────────────────────
# Variables de entorno
# Copia este archivo a `.env` para desarrollo local.
# En Railway: definí estas variables en el dashboard del servicio
# (Settings → Variables). NO subas tu .env real al repo.
# ─────────────────────────────────────────────────────────────────

# OBLIGATORIO en producción. Si no se define en dev, se genera uno
# aleatorio por sesión (los tokens no sobreviven a un restart).
# Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OBLIGATORIO en producción. En dev, si no se define, se genera uno
# aleatorio y se imprime UNA SOLA VEZ en consola al primer arranque.
ADMIN_EMAIL=admin@miempresa.com
ADMIN_PASSWORD=

# Modo de ejecución. En Railway usá "production".
NODE_ENV=development

# Puerto del servidor. Railway lo setea automáticamente — no lo definas
# manualmente en producción.
PORT=3000

# Orígenes permitidos para CORS, separados por coma. En Railway usá
# tu dominio público (ej. https://mi-dropi.up.railway.app) en vez de "*".
ALLOWED_ORIGINS=*

# Persistencia del JSON DB (server/db.js). Si lo dejás vacío, la base
# se guarda junto al código y se BORRA en cada redeploy. En Railway,
# montá un Volume y apuntá esta variable al mount path (ej. /data).
# Las imágenes generadas (ads/, landings/, etc.) viven en server/<dir>
# — el volumen también debería montarse cubriendo esos subdirectorios
# si querés que sobrevivan a los redeploys.
PERSISTENT_DATA_DIR=

# OPCIONAL — sólo si vas a usar el módulo Meta Ads Spy.
# El usuario configura su propia key vía Ajustes → APIs, así que
# normalmente no necesitás estas variables. Sirven sólo como overrides
# globales.
APIFY_ACTOR_ID=curious_coder~facebook-ads-library-scraper
APIFY_TIMEOUT_MS=90000
APIFY_MEMORY_MB=512
META_SPY_RATE_LIMIT=10
